DEBUG=True
SECRET_KEY=change-this-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite works out of the box when DB_ENGINE and DB_NAME are omitted.
# Use these values only if you want Django to connect to MySQL instead.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=floreria_db
# DB_USER=floreria_user
# DB_PASSWORD=password123
# DB_HOST=127.0.0.1
# DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3001
EXPRESS_API_URL=http://localhost:3001
GOOGLE_MAPS_API_KEY=your-google-maps-browser-api-key
